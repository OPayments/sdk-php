{
    "name": "opayments/sdk-php",
    "version": "0.1.0",
    "description": "PHP client for OPayments API",
    "keywords": [
        "opayments",
        "payments",
        "sdk"
    ],
    "homepage": "https://opayments.io",
    "license": "proprietary",
    "authors": [
        {
            "name": "OPayments",
            "homepage": "https://opayments.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "OPayments\\SDK\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "OPayments\\SDK\\Test\\" : "test/" }
    }
}
